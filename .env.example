# TeleCorp Sentinel — variables de ejemplo (SOLO placeholders; nunca ponga secretos reales aquí).
# Copie a .env.local o exporte en su shell. Los archivos .env* están ignorados por git (excepto este).

# ---------- Modo local (emulado) ----------
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOCAL_SIMULATOR=on                 # on|off: telemetría sintética cada minuto en local
LOCAL_OPERATOR_USER=operador.demo
# LOCAL_OPERATOR_PASSWORD=         # si se omite, la semilla genera una y la guarda en .local/operator-credentials.txt
# LOCAL_MASTER_KEY=                # si se omite, se genera .local/master.key (ignorado por git)
NOTIFY_ALLOWED_RECIPIENTS=*        # en local los correos sólo se escriben en .local/mailbox (no se envían)
REPORTS_PER_MINUTE_PER_IP=20

# ---------- Reglas de negocio (supuestos de diseño, configurables) ----------
COLLECTIVE_THRESHOLD=10
COLLECTIVE_WINDOW_HOURS=24
RECOVERY_CONSECUTIVE_NORMAL=3
RECURRENCE_EPISODES=3
RECURRENCE_WINDOW_DAYS=7
MISSING_DATA_AFTER_MINUTES=3
LATE_REPORT_NO_OPEN_HOURS=72
# PRIORITY_CONFIG_JSON={"levels":{"CRITICA":65,"ALTA":45,"MEDIA":25}}

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:3001

# ---------- Despliegue AWS (scripts/deploy-aws.sh) ----------
STAGE=dev
AWS_REGION=us-east-1
# LAB_ROLE_ARN=arn:aws:iam::<CUENTA>:role/LabRole
# SES_FROM_EMAIL=<correo verificado en SES>
# NOTIFY_ALLOWED_RECIPIENTS=<correos verificados separados por coma>
SIMULATOR_ENABLED=false
SCHEDULE_KIND=rule
# ALERT_EMAIL=<correo del equipo para alarmas>

# ---------- Google Cloud (infra/gcp/deploy-gcp.sh) ----------
# GCP_PROJECT_ID=<id-del-proyecto>
GCP_REGION=us-central1
# GEMINI_MODEL=<modelo verificado con ai-service/scripts/check_model.py>
# AWS_ACCOUNT_ID=<12 dígitos>
# Salidas de deploy-gcp.sh para el backend:
# AI_SERVICE_URL=https://<servicio>.run.app
# AI_AUTH_MODE=wif
# GCP_PROJECT_NUMBER=<número>
# GCP_INVOKER_SA=telecorp-ai-invoker@<proyecto>.iam.gserviceaccount.com
